{
  "name": "haru-korea",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Haru Korea — AI trip concierge — domestic & international trips, flights and hotels (affiliate + sponsored deals)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4181 --strictPort",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "lint": "oxlint",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "postinstall": "node scripts/unpack-assets.mjs",
    "assets:unpack": "node scripts/unpack-assets.mjs --force",
    "assets:pack": "node scripts/pack-assets.mjs",
    "assets": "node scripts/unpack-assets.mjs --force && node scripts/make-icons.mjs && npx @capacitor/assets generate"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
