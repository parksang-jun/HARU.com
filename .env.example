# ---- Supabase (없으면 로컬 저장 + 목업 AI 모드로 동작) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# true 이면 Edge Function 대신 고정 샘플 일정/답변 사용 (개발·e2e용)
VITE_MOCK_AI=true

# ---- 어필리에이트 (각 제휴 대시보드에서 발급받은 추적 파라미터를 쿼리스트링 그대로 입력) ----
# 예) Klook:   VITE_AFF_KLOOK_QS=aid=XXXXX
# 예) Booking: VITE_AFF_BOOKING_QS=aid=XXXXXXX
# 예) Agoda:   VITE_AFF_AGODA_QS=cid=XXXXXXX
# 예) Trip.com: VITE_AFF_TRIP_QS=Allianceid=XXXX&SID=XXXXXX
# 예) GetYourGuide: VITE_AFF_GYG_QS=partner_id=XXXXXX
# 예) Expedia(Partnerize): VITE_AFF_EXPEDIA_QS=camref=XXXXXX
VITE_AFF_KLOOK_QS=
VITE_AFF_BOOKING_QS=
VITE_AFF_AGODA_QS=
VITE_AFF_TRIP_QS=
VITE_AFF_GYG_QS=
VITE_AFF_EXPEDIA_QS=
# 항공: Skyscanner(Impact) 추적 쿼리스트링, Travelpayouts(Aviasales) marker
VITE_AFF_SKYSCANNER_QS=
VITE_TP_MARKER=
# 아래 3곳은 제휴 승인 후 받은 랜딩/딥링크 URL 전체를 입력 (검색 URL 형식 미확정)
VITE_AFF_CREATRIP_URL=
VITE_AFF_TRAZY_URL=
VITE_AFF_NOL_URL=

# ---- AdMob (네이티브 빌드에서만 동작; 기본값은 Google 공식 테스트 ID) ----
VITE_ADMOB_ENABLED=false
VITE_ADMOB_BANNER_ANDROID=ca-app-pub-3940256099942544/6300978111
VITE_ADMOB_BANNER_IOS=ca-app-pub-3940256099942544/2934735716
